# ─────────────────────────────────────────────────────────────────────────────
#  Bodegón de José — plantilla de entorno
#
#  Para empezar:  cp .env.example .env
#
#  Los valores de abajo son de DESARROLLO LOCAL y están en el repositorio, así que
#  son públicos. Para producción se generan secretos reales y se cargan como
#  variables de entorno del host — nunca en un archivo versionado.
#
#  El arranque falla a propósito si algo falta: apps/api/src/config/env.ts
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=debug

# ── API ──────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=4000

# ── PostgreSQL (lo consumen docker-compose y Prisma) ─────────────────────────
POSTGRES_USER=bodegon
POSTGRES_PASSWORD=bodegon_dev_password
POSTGRES_DB=bodegon
POSTGRES_PORT=5432
ADMINER_PORT=8080

DATABASE_URL=postgresql://bodegon:bodegon_dev_password@localhost:5432/bodegon?schema=public

# ── Secretos JWT ─────────────────────────────────────────────────────────────
# Deben medir 32 caracteres o más, y ser DISTINTOS entre sí.
# Genera los de producción con:  openssl rand -base64 48
# El prefijo dev_only_ está bloqueado en producción por la validación de entorno.
JWT_ACCESS_SECRET=dev_only_access_secret_no_usar_en_produccion
JWT_REFRESH_SECRET=dev_only_refresh_secret_no_usar_en_produccion

# ── Orígenes permitidos por CORS ─────────────────────────────────────────────
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
