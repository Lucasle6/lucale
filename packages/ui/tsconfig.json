{
  // Este paquete NO se compila a dist: Next lo transpila desde el código
  // fuente (transpilePackages en next.config.ts), lo que da recarga instantánea
  // al editar un componente. tsc aquí solo revisa tipos.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2023", "DOM"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": ["src/**/*"]
}
