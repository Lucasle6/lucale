{
  "name": "bodegon-de-jose",
  "version": "0.1.0",
  "private": true,
  "description": "E-commerce fullstack — proyecto de graduación",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm build:packages && pnpm --filter @bodegon/api dev",
    "dev:web": "pnpm --filter @bodegon/web dev",
    "dev:admin": "pnpm --filter @bodegon/admin dev",
    "build:packages": "pnpm --filter \"./packages/**\" build",
    "build": "pnpm -r build",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "test": "pnpm --filter=!@bodegon/e2e -r test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d",
    "db:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "db:reset": "docker compose --env-file .env -f infra/docker-compose.yml down -v && pnpm db:up",
    "db:logs": "docker compose --env-file .env -f infra/docker-compose.yml logs -f postgres",
    "db:migrate": "pnpm --filter @bodegon/db migrate",
    "db:seed": "pnpm --filter @bodegon/db seed",
    "db:generate": "pnpm --filter @bodegon/db generate",
    "db:studio": "pnpm --filter @bodegon/db studio",
    "prepare": "husky || true",
    "db:test:create": "docker exec bodegon-postgres psql -U bodegon -d bodegon -tc \"SELECT 1 FROM pg_database WHERE datname='bodegon_test'\" | grep -q 1 || docker exec bodegon-postgres createdb -U bodegon bodegon_test",
    "db:test:setup": "pnpm db:test:create && pnpm --filter @bodegon/db migrate:test && pnpm --filter @bodegon/db seed:test",
    "secretos": "node scripts/generar-secretos.mjs",
    "test:e2e": "pnpm --filter @bodegon/e2e test",
    "admin:crear": "node apps/api/scripts/crear-admin.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "pnpm": {
    "overrides": {
      "fast-uri@<3.1.5": "^3.1.5",
      "fast-uri@>=4 <4.1.2": "^4.1.2",
      "nanoid@<3.3.18": "^3.3.18",
      "js-yaml@<4.3.1": "^4.3.1",
      "brace-expansion@<5.0.9": "^5.0.9",
      "@fastify/static@<10.1.2": "^10.1.2"
    }
  }
}
